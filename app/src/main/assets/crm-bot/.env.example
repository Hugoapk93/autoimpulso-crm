# Autoimpulso CRM — variables de entorno
# Copia este archivo como `.env` en la misma carpeta que app.js y rellena
# los valores. NUNCA subas el `.env` real a ningún sitio: ahí va el token
# del panel y las claves push.

# Puerto del panel y de la API (por defecto 3000 si se deja vacío).
PORT=3000

# Token del panel web. OBLIGATORIO: sin él, la API responde 503 en todo
# (el backend se cierra) y el panel se queda en "Conectando...".
# Genera uno largo y secreto en el teléfono, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El mismo valor se escribe una sola vez en el panel (paso "Acceso al panel").
API_TOKEN=

# Alias opcional: src/auth.js acepta API_TOKEN o ADMIN_TOKEN.
# Puedes dejarlo vacío; solo existe por compatibilidad con el .env viejo.
ADMIN_TOKEN=

# Claves VAPID para las notificaciones push del panel.
# Opcionales: si faltan, el bot arranca igual y el push queda desactivado
# (avisa por consola). Se generan con:
#   npx web-push generate-vapid-keys
# VAPID_EMAIL debe ser una URL mailto: válida, ej. mailto:tu@correo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
